__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.DS_Store
*.log
!tests/fixtures/**/*.log
!mocks/aitest/scenarios/**/*.log
# 截断契约测试专用夹具（其余 mock 日志由 tools/generate_logs.py 本地生成，不入库）
!mocks/aitest/logs/var/log/aitest/CASE-TRUNC-BRACKET/test.log
*.tmp

# 运行数据（仅保留说明文件）
data/*
!data/README.md

# 密钥与本地环境
.env
.env.*
!.env.example
deploy/secrets/*
!deploy/secrets/README.md
deploy/env/*
!deploy/env/aitrace.env.example
deploy/config/config.prod.yaml
deploy/config/*.pem
deploy/config/*.key
/id_rsa*
/id_ed25519*

